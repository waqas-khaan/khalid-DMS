{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khalid-dms",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "khalid-dms.falconsoftwares.com",
      "custom_domain": true
    },
    {
      "pattern": "preview-dms.falconsoftwares.com",
      "custom_domain": true,
      "previews_enabled": true
    }
  ],
  "preview_urls": true,
  "previews": {}
}
